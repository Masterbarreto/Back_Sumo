# Ambiente e Servidor
NODE_ENV=development
PORT=3000

# Banco de Dados
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.mongodb.net/<nome_do_banco>?retryWrites=true&w=majority

# Segurança e Sessão
JWT_SECRET=insira_uma_chave_aleatoria_longa_e_segura_aqui
COOKIE_SECRET=insira_um_segredo_para_assinar_os_cookies
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# Configuração de E-mail (Google SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email_do_projeto@gmail.com
SMTP_PASSWORD=sua_senha_de_app_do_google_aqui
